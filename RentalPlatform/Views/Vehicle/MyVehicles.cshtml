@model List<Vehicle>
@{
    ViewData["Title"] = "Xe của tôi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Xe của tôi</h2>
    <a asp-controller="Vehicle" asp-action="Create" class="btn btn-primary">+ Đăng xe mới</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Bạn chưa đăng xe nào. Hãy bắt đầu bằng cách đăng xe đầu tiên!</div>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Ảnh</th>
                <th>Tên xe</th>
                <th>Biển số</th>
                <th>Khu vực</th>
                <th>Giá / ngày</th>
                <th>Trạng thái</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var xe in Model)
            {
                var anhDaiDien = xe.HinhAnh.FirstOrDefault(i => i.LaAnhDaiDien) ?? xe.HinhAnh.FirstOrDefault();
                <tr>
                    <td><img src="@(anhDaiDien?.DuongDanAnh ?? "/images/no-image.png")" style="width:80px;height:60px;object-fit:cover;" /></td>
                    <td>@xe.TenXe</td>
                    <td>@xe.BienSo</td>
                    <td>@xe.KhuVuc</td>
                    <td class="price-tag">@xe.GiaThueMotNgay.ToString("N0") đ</td>
                    <td>
                        @{
                            var badgeClass = xe.TrangThai switch
                            {
                                TrangThaiXe.SanSang => "bg-success",
                                TrangThaiXe.DangThue => "bg-primary",
                                TrangThaiXe.BaoTri => "bg-secondary",
                                TrangThaiXe.TuChoi => "bg-danger",
                                _ => "bg-warning text-dark"
                            };
                        }
                        <span class="badge @badgeClass">@xe.TrangThai</span>
                        @if (xe.TrangThai == TrangThaiXe.TuChoi && !string.IsNullOrWhiteSpace(xe.LyDoTuChoi))
                        {
                            <div class="small text-danger mt-1">Lý do: @xe.LyDoTuChoi</div>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-controller="Vehicle" asp-action="Edit" asp-route-id="@xe.Id" class="btn btn-sm btn-outline-secondary">Sửa</a>

                        @if (xe.TrangThai == TrangThaiXe.SanSang)
                        {
                            <form asp-controller="Vehicle" asp-action="ChangeStatus" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@xe.Id" />
                                <input type="hidden" name="status" value="@TrangThaiXe.BaoTri" />
                                <button type="submit" class="btn btn-sm btn-outline-warning">Chuyển sang bảo trì</button>
                            </form>
                        }
                        else if (xe.TrangThai == TrangThaiXe.BaoTri)
                        {
                            <form asp-controller="Vehicle" asp-action="ChangeStatus" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@xe.Id" />
                                <input type="hidden" name="status" value="@TrangThaiXe.SanSang" />
                                <button type="submit" class="btn btn-sm btn-outline-success">Chuyển về sẵn sàng</button>
                            </form>
                        }

                        <form asp-controller="Vehicle" asp-action="Delete" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@xe.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Xoá xe này?');">Xoá</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
