@model List<RentalOrder>
@if (!Model.Any())
{
    <div class="alert alert-info">Chưa có đơn thuê nào.</div>
}
else
{
    <div class="table-responsive card"><table class="table align-middle mb-0">
        <thead><tr><th>Mã đơn</th><th>Khách / Chủ xe</th><th>Xe</th><th>Trạng thái</th><th>Tổng tiền</th><th></th></tr></thead>
        <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td><strong class="text-mono">@order.MaDon</strong><div class="small text-muted">@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div></td>
                <td>@order.HoTenKhach<div class="small text-muted">Chủ: @order.Owner.HoTen</div></td>
                <td>@order.Items.Count xe<div class="small text-muted">@string.Join(", ", order.Items.Select(i => i.TenXe))</div></td>
                <td><span class="badge bg-secondary">@order.TrangThai</span></td>
                <td class="price-tag">@order.TongTien.ToString("N0") đ</td>
                <td><a asp-action="Details" asp-route-id="@order.Id" class="btn btn-outline-primary btn-sm">Chi tiết</a></td>
            </tr>
        }
        </tbody>
    </table></div>
}
