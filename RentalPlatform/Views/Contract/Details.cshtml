@model Contract
@{
    ViewData["Title"] = "Hợp đồng điện tử";
    var laKhach = Model.Booking.CustomerId == Guid.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);
    var toiDaKy = laKhach ? Model.DaKyKhach : Model.DaKyChuXe;
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <h2 class="mb-4">Hợp đồng điện tử — <span class="text-mono">@Model.SoHopDong</span></h2>

        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card @(Model.DaKyKhach ? "border-success" : "border-warning")">
                    <div class="card-body">
                        <h6 class="card-title">Bên thuê (Khách)</h6>
                        @if (Model.DaKyKhach)
                        {
                            <span class="badge bg-success">Đã ký lúc @Model.NgayKyKhach!.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Chưa ký</span>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card @(Model.DaKyChuXe ? "border-success" : "border-warning")">
                    <div class="card-body">
                        <h6 class="card-title">Bên cho thuê (Chủ xe)</h6>
                        @if (Model.DaKyChuXe)
                        {
                            <span class="badge bg-success">Đã ký lúc @Model.NgayKyChuXe!.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Chưa ký</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <pre class="border rounded p-3 bg-light" style="white-space:pre-wrap;font-family:inherit;">@Model.NoiDungHopDong</pre>

        @if (!toiDaKy)
        {
            <form asp-controller="Contract" asp-action="Sign" method="post" class="mt-3">
                <input type="hidden" name="bookingId" value="@Model.BookingId" />
                <button type="submit" class="btn btn-primary" onclick="return confirm('Xác nhận ký hợp đồng này? Hành động này không thể huỷ.');">Ký hợp đồng điện tử</button>
            </form>
        }
        else
        {
            <div class="alert alert-success mt-3">Bạn đã ký hợp đồng này.</div>
        }

        <a asp-controller="Booking" asp-action="Details" asp-route-id="@Model.BookingId" class="btn btn-outline-secondary mt-2">Quay lại đơn đặt xe</a>
    </div>
</div>
