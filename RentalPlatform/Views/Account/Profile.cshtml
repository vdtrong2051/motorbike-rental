@model ProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <div class="hero-eyebrow">Thông tin pháp lý</div>
                <h2 class="mb-1">Hồ sơ cá nhân</h2>
                <p class="text-muted mb-0">Thông tin này được dùng để lập hợp đồng thuê xe.</p>
            </div>
            <span class="badge bg-secondary">@Model.Role</span>
        </div>

        <div class="card">
            <div class="card-body">
                <div class="alert @(Model.TrangThaiXacThuc == TrangThaiXacThucNguoiDung.DaXacThuc ? "alert-success" : "alert-warning")">
                    Trạng thái xác thực: <strong>@Model.TrangThaiXacThuc</strong>.
                    @if (!string.IsNullOrWhiteSpace(Model.GhiChuXacThuc)) { <span>@Model.GhiChuXacThuc</span> }
                    Chỉ tài khoản có hồ sơ đầy đủ và đã được Admin xác thực mới có thể thuê hoặc cho thuê xe.
                </div>
                <form asp-action="Profile" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="HoTen" class="form-label"></label>
                            <input asp-for="HoTen" class="form-control" />
                            <span asp-validation-for="HoTen" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" readonly />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SDT" class="form-label"></label>
                            <input asp-for="SDT" class="form-control" />
                            <span asp-validation-for="SDT" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SoCCCD" class="form-label"></label>
                            <input asp-for="SoCCCD" class="form-control" inputmode="numeric" />
                            <span asp-validation-for="SoCCCD" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SoGPLX" class="form-label"></label>
                            <input asp-for="SoGPLX" class="form-control" />
                            <span asp-validation-for="SoGPLX" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="DiaChi" class="form-label"></label>
                            <textarea asp-for="DiaChi" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="DiaChi" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NgaySinh" class="form-label"></label>
                            <input asp-for="NgaySinh" class="form-control" />
                            <span asp-validation-for="NgaySinh" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="GioiTinh" class="form-label"></label>
                            <select asp-for="GioiTinh" class="form-select">
                                <option value="">-- Chọn --</option><option>Nam</option><option>Nữ</option><option>Khác</option>
                            </select>
                            <span asp-validation-for="GioiTinh" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <div class="card border-primary mt-2"><div class="card-body">
                                <h5>Ảnh căn cước công dân</h5>
                                <p class="small text-muted">Chụp rõ đủ bốn góc, không lóa sáng. Chấp nhận JPG, PNG, WebP; tối đa 5 MB mỗi ảnh. Ảnh chỉ chủ tài khoản và Admin được xem.</p>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label asp-for="AnhCCCDMatTruocUpload" class="form-label"></label>
                                        <input asp-for="AnhCCCDMatTruocUpload" type="file" class="form-control identity-input" accept="image/jpeg,image/png,image/webp" capture="environment" data-preview="frontPreview" />
                                        @if (Model.CoAnhCCCDMatTruoc)
                                        { <img id="frontPreview" src="@Url.Action("IdentityDocument", "Account", new { side = "front" })" class="img-fluid rounded border mt-2" style="max-height:220px" alt="CCCD mặt trước" /> }
                                        else
                                        { <img id="frontPreview" class="img-fluid rounded border mt-2 d-none" style="max-height:220px" alt="Xem trước CCCD mặt trước" /> }
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="AnhCCCDMatSauUpload" class="form-label"></label>
                                        <input asp-for="AnhCCCDMatSauUpload" type="file" class="form-control identity-input" accept="image/jpeg,image/png,image/webp" capture="environment" data-preview="backPreview" />
                                        @if (Model.CoAnhCCCDMatSau)
                                        { <img id="backPreview" src="@Url.Action("IdentityDocument", "Account", new { side = "back" })" class="img-fluid rounded border mt-2" style="max-height:220px" alt="CCCD mặt sau" /> }
                                        else
                                        { <img id="backPreview" class="img-fluid rounded border mt-2 d-none" style="max-height:220px" alt="Xem trước CCCD mặt sau" /> }
                                    </div>
                                </div>
                                <div class="small mt-2">Nếu không chọn ảnh mới, hệ thống giữ ảnh hiện tại.</div>
                            </div></div>
                        </div>
                    </div>
                    <div class="alert alert-info mt-3 mb-3">
                        Chủ xe cần cập nhật CCCD và địa chỉ trước khi nhận đơn để hợp đồng Word có đủ thông tin Bên A.
                    </div>
                    <button type="submit" class="btn btn-primary">Lưu hồ sơ</button>
                </form>
                @if (Model.HoSoDayDu && Model.TrangThaiXacThuc != TrangThaiXacThucNguoiDung.DaXacThuc && Model.TrangThaiXacThuc != TrangThaiXacThucNguoiDung.ChoDuyet)
                {
                    <form asp-action="SubmitVerification" method="post" class="mt-3">
                        <button class="btn btn-success">Gửi hồ sơ cho Admin xác thực</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.identity-input').forEach(input => input.addEventListener('change', () => {
            const file = input.files?.[0];
            const preview = document.getElementById(input.dataset.preview);
            if (!file || !preview) return;
            preview.src = URL.createObjectURL(file);
            preview.classList.remove('d-none');
        }));
    </script>
}
