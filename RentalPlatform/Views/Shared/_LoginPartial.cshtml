@using System.Security.Claims

<ul class="navbar-nav ms-auto align-items-lg-center">
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <li class="nav-item me-lg-2">
            <span class="nav-link text-light">
                Xin chào, @User.Identity.Name
                <span class="badge bg-secondary ms-1">@User.FindFirst(ClaimTypes.Role)?.Value</span>
            </span>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Account" asp-action="Profile">Hồ sơ</a>
        </li>
        <li class="nav-item">
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="btn btn-link nav-link">Đăng xuất</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Đăng nhập</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Đăng ký</a></li>
    }
</ul>
