<!doctype html>
<html lang="vi" data-gd4-ui="marketplace">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#123c38" />
    <title>@ViewData["Title"] — Motorbike Rental</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet" />
    <!-- Exactly one Bootstrap bundle in this layout. -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/gd4-core.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/gd4-marketplace.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/gd4-responsive.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="gd4-marketplace">
    <a class="gd4-skip" href="#main-content">Đi đến nội dung chính</a>
    <partial name="_Gd4MarketplaceNav" />
    <main id="main-content" class="container gd4-main" tabindex="-1">
        <partial name="_Gd4Alerts" />
        @RenderBody()
    </main>
    <footer class="gd4-footer">
        <div class="container gd4-footer-inner">
            <div><strong class="gd4-footer-brand">MOTORBIKE RENTAL</strong><p>Chọn đúng xe. Biết rõ chi phí. An tâm mỗi hành trình.</p></div>
            <nav aria-label="Liên kết chân trang" class="gd4-footer-links">
                <a asp-controller="Vehicle" asp-action="Index">Khám phá xe</a>
                <a asp-controller="Home" asp-action="Index">Cách thuê xe</a>
                <a asp-controller="Account" asp-action="Profile">Hồ sơ</a>
            </nav>
        </div>
        <div class="container gd4-copyright">© @DateTime.Now.Year Motorbike Rental · Nền tảng kết nối khách thuê và chủ xe</div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/gd4-interactions.js" asp-append-version="true" defer></script>
    @if (User.IsInRole("Customer"))
    {
        <script>
            fetch('@Url.Action("Count", "Cart")', { credentials: 'same-origin' })
                .then(r => r.ok ? r.json() : null)
                .then(data => { const el = document.getElementById('cartCount'); if (el && data) el.textContent = data.count; })
                .catch(() => {});
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
