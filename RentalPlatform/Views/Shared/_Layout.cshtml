<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RentalPlatform</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Be+Vietnam+Pro:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">RentalPlatform</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Vehicle" asp-action="Index">Tìm xe</a></li>
                    @if (User.IsInRole("Owner"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Vehicle" asp-action="MyVehicles">Xe của tôi</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="RentalOrder" asp-action="OwnerOrders">Đơn thuê</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="OwnerPortal" asp-action="Calendar">Lịch xe</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="OwnerPortal" asp-action="Dashboard">Doanh thu</a></li>
                    }
                    @if (User.IsInRole("Customer"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="RentalOrder" asp-action="MyOrders">Đơn thuê</a></li>
                        <li class="nav-item"><a class="nav-link cart-link" asp-controller="Cart" asp-action="Index">Giỏ xe <span id="cartCount" class="cart-count">0</span></a></li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="PendingVehicles">Duyệt xe</a></li>
                    }
                </ul>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>

    <div class="container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container">
            <div class="row gy-4">
                <div class="col-md-6">
                    <div class="footer-brand">
                        <span class="footer-logo">◍</span> RENTALPLATFORM
                    </div>
                    <p class="footer-desc">
                        Nền tảng kết nối chủ xe và khách thuê xe máy, ô tô tự lái —
                        tìm xe, đặt lịch, ký hợp đồng điện tử và thanh toán ngay trên web.
                    </p>
                </div>
                <div class="col-md-6">
                    <div class="footer-heading">Điều hướng</div>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li><a asp-controller="Vehicle" asp-action="Index">Tìm xe</a></li>
                        <li><a asp-controller="Account" asp-action="Register">Đăng ký</a></li>
                    </ul>
                </div>
            </div>
            <hr class="footer-divider" />
            <div class="d-flex flex-wrap justify-content-between gap-2 footer-bottom">
                <span>&copy; @DateTime.Now.Year RentalPlatform</span>
                <span>Thuê xe máy &amp; ô tô tự lái</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @if (User.IsInRole("Customer"))
    {
        <script>
            fetch('@Url.Action("Count", "Cart")')
                .then(r => r.ok ? r.json() : null)
                .then(data => { if (data) document.getElementById('cartCount').textContent = data.count; })
                .catch(() => {});
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
