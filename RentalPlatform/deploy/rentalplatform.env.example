# Chép thành /etc/rentalplatform/rentalplatform.env và thay giá trị mẫu.
# Không commit file chứa mật khẩu thật lên GitHub.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5000
ConnectionStrings__DefaultConnection="Server=127.0.0.1;Port=3306;Database=RentalPlatformDb;User=rentalapp;Password=CHANGE_THIS_PASSWORD;CharSet=utf8mb4;"
SeedAdmin__Name="Quản trị viên"
SeedAdmin__Email=admin@your-domain.example
SeedAdmin__Password=CHANGE_THIS_ADMIN_PASSWORD
Authentication__Google__ClientId=YOUR_GOOGLE_CLIENT_ID
Authentication__Google__ClientSecret=YOUR_GOOGLE_CLIENT_SECRET
Payment__WebhookSecret=CHANGE_THIS_WEBHOOK_SECRET
IdentityDocuments__StoragePath=/var/lib/rentalplatform/identity-documents
